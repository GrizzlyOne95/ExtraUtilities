// exu_hud_tint.program
//
// Overlay-panel vertex program for tinted, rotatable HUD art.
//
// Ogre overlay Panels carry no vertex colour, and the stock UITexMat vertex
// program takes its colour from COLOR0. This program instead colours the
// panel with the pass diffuse (surface_diffuse_colour), so a Lua script can
// tint a cloned material with exu.SetMaterialPassColors, and keeps UITexMat's
// texture_matrix input, so exu.SetMaterialTextureRotate turns the art about
// the panel centre. The fragment stage is the stock UITexMat_fragment
// (texture * colour); the outputs below match its inputs.

vertex_program EXU_HudTint_vertexGLSL glsl
{
    source exu_hud_tint-vertex.glsl
    syntax glsl120
    entry_point vs_main
}

vertex_program EXU_HudTint_vertexHLSL4 hlsl
{
    source exu_hud_tint-sm4.hlsl
    target vs_4_0
    entry_point exu_hud_tint_vertex
}

vertex_program EXU_HudTint_vertexHLSL hlsl
{
    source exu_hud_tint.hlsl
    target vs_3_0
    entry_point exu_hud_tint_vertex
}

vertex_program EXU_HudTint_vertex unified
{
    delegate EXU_HudTint_vertexGLSL
    delegate EXU_HudTint_vertexHLSL4
    delegate EXU_HudTint_vertexHLSL

    default_params
    {
        param_named_auto wvpMat worldviewproj_matrix
        param_named_auto texMat texture_matrix 0
        param_named_auto tintColor surface_diffuse_colour
    }
}
