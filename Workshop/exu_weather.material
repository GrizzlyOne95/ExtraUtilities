// exu_weather.material
//
// Billboard materials for the EXU baseline weather templates in
// exu_weather.particle.
//
// These inherit BZSprite/AlphaBlend from stock Redux sprites.material, which is
// the pipeline the game already uses for in-world sprite quads. Inheriting the
// stock parent rather than declaring our own passes means:
//
//   - the settings the reference material calls for (lighting off,
//     scene_blend alpha_blend, depth_write off) come from the stock parent
//     rather than being restated here;
//   - whatever material schemes Redux and OpenShim register on the stock sprite
//     path apply to these too, so there is no scheme for a renderer to miss and
//     fall back to black on;
//   - EXU has no dependency on Campaign Reimagined or any other mod.
//
// The stock sprite shader multiplies the texture by the incoming vertex colour,
// and Ogre feeds emitter colour_range values in as vertex colour. That is why
// every texture below is white with shaped alpha: the .particle template owns
// the colour, the texture owns the silhouette.
//
// PLACEHOLDER ART. The four textures are procedurally generated by
// tools/generate_weather_textures.py - original, reproducible and free of any
// third-party licensing - and are meant to be replaced by authored art. They
// are good enough to profile and tune against, not to ship as final.

import * from "sprites.material"

// A soft vertical streak. Drawn as an oriented_common billboard aligned to the
// fall direction, so the texture's long axis becomes the direction of travel.
material EXU_FX/Rain : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap exu_rain_streak.png
}

// An irregular soft mote with heavy falloff. Used large and grown further by
// the template's Scaler.
material EXU_FX/Dust : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap exu_dust_mote.png
}

// A wide, very soft veil. Peak alpha is deliberately low because haboob cards
// are enormous and heavily overlapped: density comes from stacking, so an
// opaque card would blow the whole wall out.
material EXU_FX/Haboob : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap exu_haboob_cloud.png
}

// The softest texture in the set. Mist has to read as depth rather than as
// particles, and any edge the eye can resolve turns the layer back into a pile
// of quads.
material EXU_FX/Mist : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap exu_mist_card.png
}
