diff --git a/RenderSystems/Direct3D11/src/OgreD3D11Texture.cpp b/RenderSystems/Direct3D11/src/OgreD3D11Texture.cpp
--- a/RenderSystems/Direct3D11/src/OgreD3D11Texture.cpp
+++ b/RenderSystems/Direct3D11/src/OgreD3D11Texture.cpp
@@ -626,4 +626,15 @@
-        hr = mDevice->CreateShaderResourceView(mp2DTex.Get(), &mSRVDesc,mpShaderResourceView.ReleaseAndGetAddressOf());
+        // A texture created without the shader-resource bind flag cannot have an
+        // SRV. This is valid for render-only resources; attempting the call
+        // anyway turns a recoverable resource configuration into a D3D11 error.
+        if (desc.BindFlags & D3D11_BIND_SHADER_RESOURCE)
+        {
+            hr = mDevice->CreateShaderResourceView(mp2DTex.Get(), &mSRVDesc,mpShaderResourceView.ReleaseAndGetAddressOf());
+        }
+        else
+        {
+            mpShaderResourceView.Reset();
+            hr = S_OK;
+        }
         if (FAILED(hr) || mDevice.isError())
         {
             String errorDescription = mDevice.getErrorDescription(hr);
